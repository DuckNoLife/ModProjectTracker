<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_light"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/text_expense_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary_light"
            android:textStyle="bold"
            android:textSize="17sp"
            tools:text="Title: Airport transfer" />

        <TextView
            android:id="@+id/text_expense_claimant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_primary_dark"
            tools:text="Claimant: admin" />

        <TextView
            android:id="@+id/text_expense_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/neon_cyan"
            android:textStyle="bold"
            tools:text="Amount: $120.00" />

        <TextView
            android:id="@+id/text_expense_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_primary_dark"
            tools:text="Date: 20/04/2026 • Type: Travel" />

        <TextView
            android:id="@+id/text_expense_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/text_primary_dark"
            tools:text="Taxi from airport to office" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/button_edit_expense"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/action_edit"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/neon_cyan" />

            <ImageButton
                android:id="@+id/button_delete_expense"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/action_delete"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@color/danger" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>